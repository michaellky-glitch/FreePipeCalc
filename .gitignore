# Claude Code session files (local tooling, not part of the project)
.claude/

# Nothing here is built — the app ships as source. If you ever add tooling:
node_modules/

# Local archive of superseded builds. Kept on disk for convenience, but git
# history already preserves every old version, and shipping a second copy of
# the app only raises "which one do I run?".
Previous Version/

# Michael's problem files. `HANDOVER.md` §8 has said these are gitignored since
# they existed; they were not, and a single `git add -A` would have published
# them. They are his drawings, they are the best test material in the project,
# and a copy of anything that produces a fix is frozen into `test/fixtures/`
# instead — which is what the tests read.
debug/
*.kate-swp

# Michael's internal developer notes. These stay on his machine only (his
# instruction, 2026-08-31). They were tracked and the markdown is already public
# in pushed history; untracking stops any FURTHER change going up. The folder
# also holds a licensed single-user copy of the Idelchik handbook, which must
# never reach GitHub — the same goes for the ASHRAE chapters, so do not copy any
# of them into the repo.
docs_internal/
